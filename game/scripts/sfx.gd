extends Node
## Autoload "Sfx": tiny sound pool. Sounds are generated by tools/gen_sfx.py into res://audio.

const NAMES := ["drop", "pop", "flip", "over", "best", "click"]
const POOL := 8

var streams := {}
var players: Array[AudioStreamPlayer] = []


func _ready() -> void:
	for n in NAMES:
		var path := "res://audio/%s.wav" % n
		if ResourceLoader.exists(path):
			streams[n] = load(path)
	for i in POOL:
		var p := AudioStreamPlayer.new()
		add_child(p)
		players.append(p)


func play(name: String, pitch := 1.0, volume_db := 0.0) -> void:
	if not Save.data["sound"] or not streams.has(name):
		return
	var player: AudioStreamPlayer = players[0]
	for p in players:
		if not p.playing:
			player = p
			break
	player.stream = streams[name]
	player.pitch_scale = pitch
	player.volume_db = volume_db
	player.play()
