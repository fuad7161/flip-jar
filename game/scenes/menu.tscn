[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/menu.gd" id="1_menu"]

[node name="Menu" type="Node2D"]
script = ExtResource("1_menu")

[node name="UI" type="CanvasLayer" parent="."]

[node name="Box" type="VBoxContainer" parent="UI"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -300.0
offset_top = -520.0
offset_right = 300.0
offset_bottom = 520.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="UI/Box"]
layout_mode = 2
theme_override_colors/font_outline_color = Color(0, 0, 0, 0.7)
theme_override_constants/outline_size = 12
theme_override_font_sizes/font_size = 110
text = "FLIP JAR"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="UI/Box"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.78, 0.9, 1)
theme_override_font_sizes/font_size = 26
text = "Drop. Merge. Flip the whole jar."
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="UI/Box"]
custom_minimum_size = Vector2(0, 170)
layout_mode = 2

[node name="Daily" type="Button" parent="UI/Box"]
custom_minimum_size = Vector2(0, 110)
layout_mode = 2
theme_override_font_sizes/font_size = 44
text = "DAILY  #1"

[node name="DailyInfo" type="Label" parent="UI/Box"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.78, 0.9, 1)
theme_override_font_sizes/font_size = 22
text = "3 of 3 tries left"
horizontal_alignment = 1

[node name="Free" type="Button" parent="UI/Box"]
custom_minimum_size = Vector2(0, 110)
layout_mode = 2
theme_override_font_sizes/font_size = 44
text = "FREE PLAY"

[node name="FreeInfo" type="Label" parent="UI/Box"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.78, 0.9, 1)
theme_override_font_sizes/font_size = 22
text = "best 0"
horizontal_alignment = 1

[node name="Streak" type="Label" parent="UI/Box"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "Play the daily jar to start a streak"
horizontal_alignment = 1

[node name="Spacer2" type="Control" parent="UI/Box"]
custom_minimum_size = Vector2(0, 20)
layout_mode = 2

[node name="ThemeLabel" type="Label" parent="UI/Box"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.78, 0.9, 1)
theme_override_font_sizes/font_size = 22
text = "THEMES  (unlock with daily streaks)"
horizontal_alignment = 1

[node name="Themes" type="HBoxContainer" parent="UI/Box"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Settings" type="HBoxContainer" parent="UI/Box"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 40

[node name="Sound" type="CheckButton" parent="UI/Box/Settings"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
button_pressed = true
text = "Sound"

[node name="Vibrate" type="CheckButton" parent="UI/Box/Settings"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
button_pressed = true
text = "Vibration"
